FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# DATABASE_URL - NO configurar manualmente, se calcula automáticamente
# La aplicación usa rutas absolutas para compatibilidad con Windows/Linux/Mac

# UPLOAD_FOLDER - Ruta relativa (se convertirá a absoluta automáticamente)
UPLOAD_FOLDER=uploads

MAX_CONTENT_LENGTH=5242880
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp,svg
FRONTEND_URL=http://localhost:5173
